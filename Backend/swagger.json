openapi: 3.0.0
info:
  title: API Score View
  version: 1.0.0
  description: API para cadastro de usuários, perguntas, respostas e resultados com integração em Machine Learning.
servers:
  - url: http://localhost:3000

paths:

  /usuarios:
    get:
      summary: Listar todos os usuários
      responses:
        '200':
          description: Lista de usuários
          content:
            application/json:
              schema:
                type: object
                properties:
                  usuarios:
                    type: array
                    items:
                      $ref: '#/components/schemas/Usuario'
        '500':
          $ref: '#/components/responses/ErroInterno'

    post:
      summary: Criar novo usuário
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/NovoUsuario'
      responses:
        '201':
          description: Usuário criado
          content:
            application/json:
              schema:
                type: object
                properties:
                  message:
                    type: string
                  id:
                    type: integer
        '400':
          $ref: '#/components/responses/RequisicaoInvalida'
        '500':
          $ref: '#/components/responses/ErroInterno'

  /usuarios/{id}:
    parameters:
      - $ref: '#/components/parameters/Id'
    get:
      summary: Obter usuário por ID
      responses:
        '200':
          description: Dados do usuário
          content:
            application/json:
              schema:
                type: object
                properties:
                  usuario:
                    $ref: '#/components/schemas/Usuario'
        '404':
          $ref: '#/components/responses/NaoEncontrado'
        '500':
          $ref: '#/components/responses/ErroInterno'

    put:
      summary: Atualizar usuário
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/NovoUsuario'
      responses:
        '200':
          description: Usuário atualizado
          content:
            application/json:
              schema:
                type: object
                properties:
                  message:
                    type: string
        '400':
          $ref: '#/components/responses/RequisicaoInvalida'
        '404':
          $ref: '#/components/responses/NaoEncontrado'
        '500':
          $ref: '#/components/responses/ErroInterno'

    delete:
      summary: Deletar usuário
      responses:
        '200':
          description: Usuário deletado
          content:
            application/json:
              schema:
                type: object
                properties:
                  message:
                    type: string
        '404':
          $ref: '#/components/responses/NaoEncontrado'
        '500':
          $ref: '#/components/responses/ErroInterno'


  /perguntas:
    get:
      summary: Listar perguntas
      responses:
        '200':
          description: Lista de perguntas
          content:
            application/json:
              schema:
                type: object
                properties:
                  perguntas:
                    type: array
                    items:
                      $ref: '#/components/schemas/Pergunta'
        '500':
          $ref: '#/components/responses/ErroInterno'

    post:
      summary: Criar pergunta
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/NovaPergunta'
      responses:
        '201':
          description: Pergunta criada
          content:
            application/json:
              schema:
                type: object
                properties:
                  message:
                    type: string
                  id:
                    type: integer
        '400':
          $ref: '#/components/responses/RequisicaoInvalida'
        '500':
          $ref: '#/components/responses/ErroInterno'

  /perguntas/{id}:
    parameters:
      - $ref: '#/components/parameters/Id'
    put:
      summary: Atualizar pergunta
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/NovaPergunta'
      responses:
        '200':
          description: Pergunta atualizada
          content:
            application/json:
              schema:
                type: object
                properties:
                  message:
                    type: string
        '404':
          $ref: '#/components/responses/NaoEncontrado'
        '500':
          $ref: '#/components/responses/ErroInterno'

    delete:
      summary: Deletar pergunta
      responses:
        '200':
          description: Pergunta deletada
          content:
            application/json:
              schema:
                type: object
                properties:
                  message:
                    type: string
        '404':
          $ref: '#/components/responses/NaoEncontrado'
        '500':
          $ref: '#/components/responses/ErroInterno'


  /respostas:
    get:
      summary: Listar respostas
      responses:
        '200':
          description: Lista de respostas
          content:
            application/json:
              schema:
                type: object
                properties:
                  respostas:
                    type: array
                    items:
                      $ref: '#/components/schemas/Resposta'
        '500':
          $ref: '#/components/responses/ErroInterno'

    post:
      summary: Criar resposta e gerar resultado
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/NovaResposta'
      responses:
        '201':
          description: Resposta e resultado salvos
          content:
            application/json:
              schema:
                type: object
                properties:
                  message:
                    type: string
                  resultado:
                    type: string
        '400':
          $ref: '#/components/responses/RequisicaoInvalida'
        '500':
          $ref: '#/components/responses/ErroInterno'


  /respostas/{id}:
    parameters:
      - $ref: '#/components/parameters/Id'
    get:
      summary: Obter resposta por ID
      responses:
        '200':
          description: Dados da resposta
          content:
            application/json:
              schema:
                type: object
                properties:
                  resposta:
                    $ref: '#/components/schemas/Resposta'
        '404':
          $ref: '#/components/responses/NaoEncontrado'
        '500':
          $ref: '#/components/responses/ErroInterno'

    put:
      summary: Atualizar resposta
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/NovaResposta'
      responses:
        '200':
          description: Resposta atualizada
          content:
            application/json:
              schema:
                type: object
                properties:
                  message:
                    type: string
        '404':
          $ref: '#/components/responses/NaoEncontrado'
        '500':
          $ref: '#/components/responses/ErroInterno'

    delete:
      summary: Deletar resposta
      responses:
        '200':
          description: Resposta deletada
          content:
            application/json:
              schema:
                type: object
                properties:
                  message:
                    type: string
        '404':
          $ref: '#/components/responses/NaoEncontrado'
        '500':
          $ref: '#/components/responses/ErroInterno'


  /resultados:
    get:
      summary: Listar resultados
      responses:
        '200':
          description: Lista de resultados
          content:
            application/json:
              schema:
                type: object
                properties:
                  resultados:
                    type: array
                    items:
                      $ref: '#/components/schemas/Resultado'
        '500':
          $ref: '#/components/responses/ErroInterno'

    post:
      summary: Criar resultado manual
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/NovoResultado'
      responses:
        '201':
          description: Resultado criado
          content:
            application/json:
              schema:
                type: object
                properties:
                  message:
                    type: string
                  id:
                    type: integer
        '400':
          $ref: '#/components/responses/RequisicaoInvalida'
        '500':
          $ref: '#/components/responses/ErroInterno'

  /resultados/{id}:
    parameters:
      - $ref: '#/components/parameters/Id'
    get:
      summary: Obter resultado por ID
      responses:
        '200':
          description: Dados do resultado
          content:
            application/json:
              schema:
                type: object
                properties:
                  resultado:
                    $ref: '#/components/schemas/Resultado'
        '404':
          $ref: '#/components/responses/NaoEncontrado'
        '500':
          $ref: '#/components/responses/ErroInterno'

    put:
      summary: Atualizar resultado
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/NovoResultado'
      responses:
        '200':
          description: Resultado atualizado
          content:
            application/json:
              schema:
                type: object
                properties:
                  message:
                    type: string
        '404':
          $ref: '#/components/responses/NaoEncontrado'
        '500':
          $ref: '#/components/responses/ErroInterno'

    delete:
      summary: Deletar resultado
      responses:
        '200':
          description: Resultado deletado
          content:
            application/json:
              schema:
                type: object
                properties:
                  message:
                    type: string
        '404':
          $ref: '#/components/responses/NaoEncontrado'
        '500':
          $ref: '#/components/responses/ErroInterno'


components:
  parameters:
    Id:
      name: id
      in: path
      required: true
      schema:
        type: integer

  responses:
    ErroInterno:
      description: Erro interno no servidor
      content:
        application/json:
          schema:
            type: object
            properties:
              error:
                type: string
    RequisicaoInvalida:
      description: Dados inválidos
      content:
        application/json:
          schema:
            type: object
            properties:
              error:
                type: string
    NaoEncontrado:
      description: Não encontrado
      content:
        application/json:
          schema:
            type: object
            properties:
              error:
                type: string

  schemas:
    Usuario:
      type: object
      properties:
        id:
          type: integer
        nome:
          type: string
        sexo:
          type: string

    NovoUsuario:
      type: object
      required: [nome, sexo]
      properties:
        nome:
          type: string
        sexo:
          type: string

    Pergunta:
      type: object
      properties:
        id:
          type: integer
        coluna_dataset:
          type: string
        texto_pergunta:
          type: string

    NovaPergunta:
      type: object
      required: [coluna_dataset, texto_pergunta]
      properties:
        coluna_dataset:
          type: string
        texto_pergunta:
          type: string

    Resposta:
      type: object
      properties:
        id:
          type: integer
        id_usuario:
          type: integer
        resposta_01:
          type: number
        resposta_02:
          type: number
        resposta_03:
          type: number
        resposta_04:
          type: number
        resposta_05:
          type: number
        resposta_06:
          type: number
        resposta_07:
          type: number
        resposta_08:
          type: number
        resposta_09:
          type: number
        resposta_10:
          type: number

    NovaResposta:
      type: object
      required:
        [id_usuario, resposta_01, resposta_02, resposta_03, resposta_04,
         resposta_05, resposta_06, resposta_07, resposta_08, resposta_09, resposta_10]
      properties:
        id_usuario:
          type: integer
        resposta_01:
          type: number
        resposta_02:
          type: number
        resposta_03:
          type: number
        resposta_04:
          type: number
        resposta_05:
          type: number
        resposta_06:
          type: number
        resposta_07:
          type: number
        resposta_08:
          type: number
        resposta_09:
          type: number
        resposta_10:
          type: number

    Resultado:
      type: object
      properties:
        id:
          type: integer
        id_usuario:
          type: integer
        resultado:
          type: string

    NovoResultado:
      type: object
      required: [id_usuario, resultado]
      properties:
        id_usuario:
          type: integer
        resultado:
          type: string
